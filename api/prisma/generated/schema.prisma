// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MeetingStatus {
  PENDING
  UPCOMING
  ONGOING
  FINISHED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
  ATTENDED
  ABSENT
}

model User {
  userId    Int    @id @default(autoincrement())
  username  String @unique
  email     String @unique
  firstname String
  lastname  String
  password  String @map("password_hash")

  ownedGroups   Group[]
  groupMembers  GroupMember[]
  notifications Notification[]
  attendance    Attendance[]

  sentInvites GroupMember[] @relation("invitedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Group {
  groupId     Int     @id @default(autoincrement())
  name        String
  description String?

  members       GroupMember[]
  notifications Notification[]
  meetings      Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User? @relation(fields: [userId], references: [userId])
  userId Int?

  @@unique([groupId, userId])
  @@map("groups")
}

model GroupMember {
  memberId  Int
  groupId   Int
  role      Role         @default(MEMBER)
  status    InviteStatus @default(PENDING)
  invitedBy Int
  joinedAt  DateTime?

  user    User  @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  inviter User  @relation("invitedBy", fields: [invitedBy], references: [userId])

  @@id([memberId, groupId])
  @@map("members")
}

model Meeting {
  meetingId   Int           @id @default(autoincrement())
  groupId     Int
  title       String
  description String?
  status      MeetingStatus @default(PENDING)
  building    String?
  floor       String?
  roomNumber  String?

  schedule DateTime
  endsAt   DateTime?

  group Group @relation(fields: [groupId], references: [groupId])

  attendance    Attendance[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetings")
}

model Notification {
  notificationId Int  @id @default(autoincrement())
  userId         Int
  groupId        Int
  meetingId      Int? // optional, not all notifications may be meeting-related

  subject String
  body    String             @db.Text
  status  NotificationStatus @default(PENDING)

  user    User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [meetingId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model Attendance {
  meetingId   Int
  memberId    Int
  status      AttendanceStatus @default(PENDING)
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [meetingId], onDelete: Cascade)
  member  User    @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@id([meetingId, memberId])
  @@map("attendance")
}
